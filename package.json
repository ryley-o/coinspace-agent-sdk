{
  "name": "coinspace-agent-sdk",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* run build",
    "lint": "pnpm -r run lint",
    "dev:docs": "pnpm --filter @coinspace-social/docs run dev",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --no-frozen-lockfile --lockfile-only",
    "release": "node scripts/publish-packages.mjs"
  },
  "packageManager": "pnpm@11.25.0",
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "typescript": "^5.7.0"
  }
}
